<script runat="server">
try {
  Platform.Load("Core", "1");
  Write('<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Push Advice diagnostic</title></head><body style="font-family:sans-serif;padding:24px;">');
  Write("<h1>CloudPage diagnostic</h1>");
  Write("<p>SSJS and Platform.Load succeeded.</p>");
  try {
    var rows = Platform.Function.LookupRows("SFMC_SS_DASHBOARD", ["Environment"], ["PROD"]);
    var count = rows && rows.length ? rows.length : 0;
    Write("<p>SFMC_SS_DASHBOARD: " + count + " row(s) for Environment=PROD.</p>");
  } catch (deErr) {
    Write('<p style="color:#721c24;">SFMC_SS_DASHBOARD lookup failed: ' + String(deErr).replace(/</g, "&lt;") + "</p>");
  }
  try {
    var de = DataExtension.Init("PA_Server_Side_Engagement");
    Write("<p>PA_Server_Side_Engagement: " + (de ? "found" : "not found") + "</p>");
  } catch (engErr) {
    Write('<p style="color:#721c24;">PA_Server_Side_Engagement: ' + String(engErr).replace(/</g, "&lt;") + "</p>");
  }
  Write("</body></html>");
} catch (fatalErr) {
  Write('<!DOCTYPE html><html><body style="font-family:sans-serif;padding:24px;color:#721c24;">');
  Write("<h1>Diagnostic fatal error</h1>");
  Write("<pre>" + String(fatalErr).replace(/</g, "&lt;") + "</pre>");
  Write("</body></html>");
}
</script>
